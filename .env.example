# Get your Privy App ID at https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# Vault contract address (deploy first, then fill this in)
NEXT_PUBLIC_VAULT_ADDRESS=0x...

# Base chain USDC address
NEXT_PUBLIC_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Aave V3 Pool address on Base
NEXT_PUBLIC_AAVE_POOL_ADDRESS=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5

# Aave aUSDC address on Base (aToken you receive)
NEXT_PUBLIC_AUSDC_ADDRESS=0x4e65fE4DbA92790696d040ac24Aa414708F5c0AB

# Optional: canonical site URL for social (OG) image links. On Vercel this
# falls back to the deployment URL automatically; set it for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://salvadanaio.example.com

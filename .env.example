# Salvadanaio runs with NO env vars by default:
#  - Wallet (Base Account) is keyless — no app id, no account needed.
#  - Contract addresses are built in per-chain (Base Sepolia stataUSDC + USDC).
#
# Everything below is OPTIONAL — overrides for local experiments only.

# Override the vault (Aave stataUSDC ERC-4626 wrapper) address.
# NEXT_PUBLIC_VAULT_ADDRESS=0x...

# Override the USDC address.
# NEXT_PUBLIC_USDC_ADDRESS=0x...

# Override the Aave faucet address (testnet USDC mint).
# NEXT_PUBLIC_FAUCET_ADDRESS=0x...

# Optional: canonical site URL for social (OG) image links. On Vercel this
# falls back to the deployment URL automatically; set it for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://salvadanaio.example.com
